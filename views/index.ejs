<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Journal</title>
    <link rel="stylesheet" href="/styles/index.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="container">
      <div class="head-part">
        <h1 class="heading">Journal</h1>
        <!-- <small> (Logged in user: <%= loggedInUser %>) </small> -->
        <form action="/logout" method="get">
          <button class="logout-btn">Logout</button>
        </form>
      </div>
      <ul id="postsList">
        <% posts.forEach(post => { %> <% if (post.id && post.title &&
        post.content && post.author && post.date) { %>
        <li>
          <h2 id="title"><%= post.title %></h2>
          <small id="author">By: <%= post.author %> </small>
          <p><%= post.content %></p>
          <small id="date"> <%= post.date %> </small>

          <% if (post.author.trim().toLowerCase() ===
          loggedInUser.trim().toLowerCase()) { %>
          <a class="edit" href="/edit/<%= post.id %>" id="editSvg"
            ><img src="/assets/edit.svg"
          /></a>
          <a class="delete" href="/delete/<%= post.id %>"
            ><img src="/assets/delete.svg" id="deleteSvg"
          /></a>
          <% } %>
          <hr style="width: 95%; margin: 10px 0px; border: 1px solid" />
        </li>
        <% } %> <% }) %>
      </ul>
    </div>

    <a href="/new" class="newbtn" id="create-button" class="hidden">+</a>

    <script>
      const button = document.getElementById("create-button");

      document.addEventListener("mousemove", (event) => {
        const viewportHeight = window.innerHeight;
        const cursorY = event.clientY;

        if (cursorY > viewportHeight * 0.8) {
          button.classList.add("unhide");
        } else {
          button.classList.remove("unhide");
        }
      });
    </script>
  </body>
</html>
